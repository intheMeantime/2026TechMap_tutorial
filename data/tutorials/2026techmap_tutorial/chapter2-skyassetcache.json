 idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private(set) var state: State = .idle","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","            let (texture, loadedCloudA, loadedCloudB) = try await (","                skyTexture,","                cloudA,","                cloudB","            )","","            var material = UnlitMaterial()","            material.color = .init(tint: .white, texture: .init(texture))","","            let skyMesh = MeshResource.generateSphere(radius: 100)","            let skyEntity = ModelEntity(mesh: skyMesh, materials: [material])","            skyEntity.scale = SIMD3<Float>(-1, 1, 1)","","            skyEntityTemplate = skyEntity","            cloudATemplate = loadedCloudA","            cloudBTemplate = loadedCloudB","            state = .ready","        }","","        loadingTask = task","    }","}"],"highlights":[{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50},{"line":51},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":62},{"line":63},{"line":64},{"line":65},{"line":66},{"line":67},{"line":68},{"line":69},{"line":70}]},"SkyAssetCache-05.swift":{"highlights":[{"line":71},{"line":72},{"line":73},{"line":74},{"line":75},{"line":76},{"line":77},{"line":78},{"line":79},{"line":80},{"line":81},{"line":82}],"type":"file","fileType":"swift","fileName":"SkyAssetCache.swift","content":["\/\/","\/\/  SkyAssetCache.swift","\/\/  OvertheCloud","\/\/","","import RealityKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private(set) var state: State = .idle","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","            let (texture, loadedCloudA, loadedCloudB) = try await (","                skyTexture,","                cloudA,","                cloudB","            )","","            var material = UnlitMaterial()","            material.color = .init(tint: .white, texture: .init(texture))","","            let skyMesh = MeshResource.generateSphere(radius: 100)","            let skyEntity = ModelEntity(mesh: skyMesh, materials: [material])","            skyEnti