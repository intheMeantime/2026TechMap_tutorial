":"paragraph"}],"type":"step","code":"SkyAssetCache-03.swift","media":null,"caption":[],"runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"새 "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" 안에서 세 로딩 요청을 시작합니다. "},{"type":"codeVoice","code":"async let"},{"type":"text","text":"은 여기서 작업을"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"시작만"}],"type":"strong"},{"type":"text","text":" 하므로 아직 기다리지 않습니다. 하늘 텍스처는 앱 번들에서,"},{"type":"text","text":" "},{"type":"codeVoice","code":"Cloud_A"},{"type":"text","text":"와 "},{"type":"codeVoice","code":"Cloud_B"},{"type":"text","text":"는 "},{"code":"cloudpracticeBundle","type":"codeVoice"},{"type":"text","text":"에서 찾습니다."}]}],"type":"step","code":"SkyAssetCache-04a.swift","media":null,"caption":[],"runtimePreview":null},{"media":null,"code":"SkyAssetCache-04.swift","type":"step","runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"text":"세 요청을 묶어 ","type":"text"},{"type":"codeVoice","code":"try await"},{"text":"하면 모두 끝날 때까지 기다린 뒤 결과를 한 번에","type":"text"},{"text":" ","type":"text"},{"text":"받을 수 있습니다. 텍스처로 ","type":"text"},{"type":"codeVoice","code":"UnlitMaterial"},{"text":"을 만들고 큰 구체의 안쪽이","type":"text"},{"text":" ","type":"text"},{"text":"보이도록 X축 스케일을 음수로 바꿉니다. 마지막으로 만들어진 하늘과 두","type":"text"},{"text":" ","type":"text"},{"text":"구름 원본을 캐시에 저장하고 상태를 ","type":"text"},{"type":"codeVoice","code":".ready"},{"text":"로 갱신합니다.","type":"text"}],"type":"paragraph"}]},{"media":null,"code":"SkyAssetCache-05.swift","type":"step","runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"이제 ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":"의 완료를 실제로 기다리고 성공·실패를 정리합니다. 성공 시에는","type":"text"},{"text":" ","type":"text"},{"code":"loadingTask","type":"codeVoice"},{"text":"만 비워 다음 호출을 가볍게 만들고, 실패 시에는 저장했던","type":"text"},{"text":" ","type":"text"},{"text":"템플릿도 비운 뒤 ","type":"text"},{"code":".failed","type":"codeVoice"},