siveSpaceState {","        case .closed:","            \"구름 위로 올라가기\"","        case .opening:","            \"구름 위로 올라가는 중…\"","        case .open:","            \"땅으로 내려오기\"","        case .closing:","            \"땅으로 내려오는 중…\"","        }","    }","","    private var canToggleImmersiveSpace: Bool {","        guard assetLoadState == .ready else {","            return false","        }","","        switch appModel.immersiveSpaceState {","        case .closed, .open:","            return true","        case .opening, .closing:","            return false","        }","    }","","    private func loadAssets() async {","        assetLoadState = .loading","","        do {","            try await SkyAssetCache.shared.preload()","            assetLoadState = .ready","        } catch {","            assetLoadState = .failed(error.localizedDescription)","        }","    }","","    private func toggleImmersiveSpace() async {","        \/\/ 다음 단계에서 구현합니다.","    }","}","","#Preview(windowStyle: .automatic) {","    ContentView()","        .environment(AppModel())","}"],"syntax":"swift","identifier":"ContentView-03.swift"},"ContentView-04.swift":{"highlights":[{"line":111},{"line":112},{"line":113},{"line":114},{"line":115},{"line":116},{"line":117},{"line":118},{"line":119},{"line":120},{"line":121},{"line":122},{"line":123},{"line":124},{"line":125},{"line":126},{"line":127},{"line":128},{"line":129},{"line":130},{"line":131},{"line":132},{"line":133},{"line":134},{"line":135},{"line":136},{"line":137},{"line":138},{"line":139}],"type":"file","fileType":"swift","fileName":"ContentView.swift","content":["\/\/","\/\/  ContentView.swift","\/\/  OvertheCloud","\/\/","","import SwiftUI","","struct ContentView: View {","    private enum AssetLoadState: Equatable {","        case loading","        case ready","        case failed(String)","    }","","    @Environment(\\.openImmersiveSpace) private var openImmersiveSpace","    @Environment(\\.dismissImmersiveSpace) private var dismis