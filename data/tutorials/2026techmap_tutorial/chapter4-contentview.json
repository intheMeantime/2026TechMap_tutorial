"        }","    }","","    private var canToggleImmersiveSpace: Bool {","        guard assetLoadState == .ready else {","            return false","        }","","        switch appModel.immersiveSpaceState {","        case .closed, .open:","            return true","        case .opening, .closing:","            return false","        }","    }","","    private func loadAssets() async {","        assetLoadState = .loading","","        do {","            try await SkyAssetCache.shared.preload()","            assetLoadState = .ready","        } catch {","            assetLoadState = .failed(error.localizedDescription)","        }","    }","","    private func toggleImmersiveSpace() async {","        immersiveSpaceErrorMessage = nil","","        switch appModel.immersiveSpaceState {","        case .closed:","            guard SkyAssetCache.shared.isReady else {","                assetLoadState = .failed(\"필수 에셋이 준비되지 않았습니다.\")","                return","            }","","            appModel.immersiveSpaceState = .opening","            switch await openImmersiveSpace(id: \"SkySpace\") {","            case .opened:","                appModel.immersiveSpaceState = .open","            case .userCancelled:","                appModel.immersiveSpaceState = .closed","            case .error:","                appModel.immersiveSpaceState = .closed","                immersiveSpaceErrorMessage = \"몰입 공간을 열지 못했습니다. 잠시 후 다시 시도해 주세요.\"","            @unknown default:","                appModel.immersiveSpaceState = .closed","                immersiveSpaceErrorMessage = \"몰입 공간의 상태를 확인하지 못했습니다.\"","            }","        case .open:","            appModel.immersiveSpaceState = .closing","            await dismissImmersiveSpace()","            appModel.immersiveSpaceState = .closed","        case .opening, .closing:","            break","        }","    }","}","","#Preview(windowStyle: .automatic) {","    ContentView()","        .environment(AppModel())","}"],"syntax":"swift","i