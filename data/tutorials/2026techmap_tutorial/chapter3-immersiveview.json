%B0":{"title":"에셋 로딩 상태 UI 만들기","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#%EC%97%90%EC%85%8B-%EB%A1%9C%EB%94%A9-%EC%83%81%ED%83%9C-UI-%EB%A7%8C%EB%93%A4%EA%B8%B0","type":"section","abstract":[{"text":"메인 윈도우는 에셋이 준비되었는지 보여주고, 사용자가 버튼을 눌러 몰입 공간을","type":"text"},{"type":"text","text":" "},{"type":"text","text":"열고 닫을 수 있게 합니다. 이번 챕터에서는 로딩 상태에 따른 UI 분기와,"},{"type":"text","text":" "},{"type":"codeVoice","code":"openImmersiveSpace"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"dismissImmersiveSpace"},{"text":" 환경 값을 이용한 전환 로직을","type":"text"},{"type":"text","text":" "},{"type":"text","text":"완성합니다."}],"url":"\/tutorials\/2026techmap_tutorial\/chapter4-contentview#%EC%97%90%EC%85%8B-%EB%A1%9C%EB%94%A9-%EC%83%81%ED%83%9C-UI-%EB%A7%8C%EB%93%A4%EA%B8%B0","kind":"section","role":"pseudoSymbol"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/1.-----------":{"role":"article","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-----------","kind":"article","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/1.-----------","title":"1. 상태 모델 설계하기","abstract":[]},"ImmersiveView-05.swift":{"fileName":"ImmersiveView.swift","identifier":"ImmersiveView-05.swift","content":["\/\/","\/\/  ImmersiveView.swift","\/\/  OvertheCloud","\/\/","","import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                \/\/ 애니메이션 적용","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    \/\/\/ 크기와 회전 값을 보존하면서 위아래로만 움직이는 애니메이션","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"syntax":"swift","type":"file","fileType":"swift","highlights":[{"line":40},{"line":41},{