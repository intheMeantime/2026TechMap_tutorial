,"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView"},"references":{"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","kind":"project","abstract":[{"type":"text","text":"캐싱해 둔 하늘과 구름 배경을 실제 공간에 배치할 차례입니다. "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":"로"},{"type":"text","text":" "},{"type":"text","text":"사용자를 감싸는 하늘을 만들고, 여러 구름에 서로 다른 모양과 움직임을 부여합니다."}],"title":"Immersive View 콘텐츠 구성하기","role":"project","estimatedTime":"20min","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview","type":"topic"},"ImmersiveView-03a.swift":{"syntax":"swift","highlights":[{"line":22},{"line":23},{"line":24}],"content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                content.add(cloudEntity)","            }","        }","    }","}"],"type":"file","fileType":"swift","fileName":"ImmersiveView.swift","identifier":"ImmersiveView-03a.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup#%ED%95%98%EB%8A%98-%EB%B0%B0%EA%B2%BD%EA%B3%BC-%EA%B5%AC%EB%A6%84-%EB%AA%A8%EB%8D%B8%EC%9D%84-Xcode%EC%97%90-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#%ED%95%98%EB%8A%98-%EB%B0%B0%EA%B2%BD%EA%B3%BC-%EA%B5%AC%EB%A6%84-%EB%AA%A8%EB%8D%B8%EC%9D%84-Xcode%EC%97%90-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","kind":"section","abstract":[{"type":"text","text":"이 튜토리얼은 앱 번들의 하늘 배경와 로컬 Swift 패키지의 구름 모델을 사용합니다."},{"type":"text","text":" "},{"type":"text","text":"아래 Project files에서 "},{"type":"codeVoice","code":"OvertheCloud-Assets.zip"},{"type":"text","text":"을 내려받고 압축을 푼 뒤,"},{"type":"text","text":" "},{"type":"text","text":"두 종류의 에셋을 각각 앱 타깃과 패키지 의존성에 연결합니다."}],"title":"하늘 배경과 구름 모델을 Xcode에 연결하기","role":"pseudoSymbol","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup#%ED%95%98%EB%8A%98-%EB%B0%B0%EA%B2%BD%EA%B3%BC-%EA%B5%AC%EB%A6%84-%EB%AA%A8%EB%8D%B8%EC%9D%84-Xcode%EC%97%90-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","type":"section"},"ImmersiveView-04.swift":{"syntax":"swift","highlights":[{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50},{"line":51},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56}],"content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                content.add(cloudEntity)","            }","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"type":"file","fileType":"swift","fileName":"ImmersiveView.swift","identifier":"ImmersiveView-04.swift"},"ch_thumbnail.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/2026TechMap_tutorial\/ch_thumbnail.png"}],"type":"image","alt":"푸른 하늘과 구름을 표현한 챕터 헤더 배경","identifier":"ch_thumbnail.png"},"ImmersiveView-03.swift":{"syntax":"swift","highlights":[{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34}],"content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","