   let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","        }","    }","}"],"syntax":"swift","fileName":"ImmersiveView.swift","type":"file"},"ImmersiveView-05.swift":{"identifier":"ImmersiveView-05.swift","highlights":[{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"fileName":"ImmersiveView.swift","syntax":"swift","fileType":"swift","type":"file","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup":{"type":"topic","abstract":[{"text":"이 튜토리얼은 앱 번들의 하늘 배경와 로컬 Swift 패키지의 구름 모델을 사용합니다.","type":"text"},{"text":" ","type":"text"},{"text":"아래 Project files에서 ","type":"text"},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"text":"을 내려받고 압축을 푼 뒤,","type":"text"},{"text":" ","type":"text"},{"text":"두 종류의 에셋을 각각 앱 타깃과 패키지 의존성에 연결합니다.","type":"text"}],"title":"프로젝트와 에셋 준비하기","kind":"project","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup","role":"project","estimatedTime":"15min"},"ImmersiveView-00.swift":{"highlights":[],"fileType":"swift","identifier":"ImmersiveView-00.swift","fileName":"ImmersiveView.swift","syntax":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    var body: some View {","        RealityView { _ in }