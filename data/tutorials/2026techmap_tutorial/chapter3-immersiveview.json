le = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                \/\/ 위치(Position) 무작위 배치","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                content.add(cloudEntity)","            }","        }","    }","}"],"syntax":"swift","identifier":"ImmersiveView-03.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/2.---------------":{"type":"topic","abstract":[],"kind":"article","role":"article","url":"\/tutorials\/2026techmap_tutorial\/2.---------------","title":"2. 에셋 프리로딩 캐시 만들기","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.---------------"},"ImmersiveView-01.swift":{"highlights":[],"type":"file","fileType":"swift","fileName":"ImmersiveView.swift","content":["\/\/","\/\/  ImmersiveView.swift","\/\/  OvertheCloud","\/\/","","import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","        }","    }","}"],"syntax":"swift","identifier":"ImmersiveView-01.swift"}}}