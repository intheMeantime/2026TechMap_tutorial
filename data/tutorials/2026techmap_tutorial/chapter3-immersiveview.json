tup#visionOS-%EC%95%B1%EA%B3%BC-%EC%A0%9C%EA%B3%B5-%ED%8C%8C%EC%9D%BC-%EC%A4%80%EB%B9%84%ED%95%98%EA%B8%B0"},"ImmersiveView-05.swift":{"fileType":"swift","fileName":"ImmersiveView.swift","syntax":"swift","highlights":[{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"type":"file","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"identifier":"ImmersiveView-05.swift"},"ImmersiveView-00.swift":{"identifier":"ImmersiveView-00.swift","fileName":"ImmersiveView.swift","fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    var body: some View {","        RealityView { _ in }","    }","}"],"syntax":"swift","type":"file","highlights":[]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/3.---------------":{"kind":"article","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/3.---------------","role":"article","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/3.---------------","title":"3. 에셋 프리로딩 캐시 만들기","abstract":[]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/1.--------------":{"type":"topic","kind":"article","role":"article","url":"\/tutorials\/2026techmap_tutorial\/1.--------------","title":"1. 프로젝트와 에셋 준비하기","abstract":[],"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.--------------"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/5.--------UI-------":{"title":"5. 메인 윈도우 UI와 전환 로직","url":"\/tutorials\/2026techmap_tutor