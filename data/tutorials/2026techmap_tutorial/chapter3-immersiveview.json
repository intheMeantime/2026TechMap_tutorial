"    }","}"],"fileType":"swift","syntax":"swift","type":"file"},"ImmersiveView-05.swift":{"fileType":"swift","type":"file","identifier":"ImmersiveView-05.swift","syntax":"swift","fileName":"ImmersiveView.swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"highlights":[{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#%EC%BA%90%EC%8B%9C%EA%B0%80-%EB%B3%B4%EA%B4%80%ED%95%A0-%EA%B0%92-%EC%A0%95%ED%95%98%EA%B8%B0":{"abstract":[{"text":"몰입 공간을 열 때마다 하늘 텍스처와 구름 모델을 새로 불러오면 전환이 버벅입니다.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"이번 챕터에서는 앱이 실행되는 즉시 필요한 에셋을 비동기로 불러두는"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SkyAssetCache"},{"text":"를 만듭니다.","type":"text"}],"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#%EC%BA%90%EC%8B%9C%EA%B0%80-%EB%B3%B4%EA%B4%80%ED%95%A0-%EA%B0%92-%EC%A0%95%ED%95%98%EA%B8%B0","title":"캐시가 보관할 값 정하기","kind":"section","role":"pseudoSymbol","type":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#%EC%BA%90%EC%8B%9C%EA%B0%80-%EB%B3%B4%EA%B4%80%ED%95%A0-%EA%B0%92-%EC%A0%95%ED%95%98%EA%B8%B0"},"ImmersiveView-03.swift":{"fileType":"swift","type":"file","identifier":"ImmersiveView-03.swift","syntax":"swift","fileName":"ImmersiveView.swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private 