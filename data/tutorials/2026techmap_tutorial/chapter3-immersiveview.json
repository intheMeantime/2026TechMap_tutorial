Scale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"type":"file","fileType":"swift","fileName":"ImmersiveView.swift","identifier":"ImmersiveView-05.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#%EC%97%90%EC%85%8B%EC%9D%84-%ED%95%9C-%EB%B2%88%EB%A