{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[{"title":"Preload and cache assets","estimatedTimeInMinutes":20,"kind":"hero","image":"ch_thumbnail.png","chapter":"3. Preload and cache assets","content":[{"inlineContent":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}],"type":"paragraph"}],"backgroundImage":"ch_thumbnail.png"},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"inlineContent":[{"text":"The cache stores loading state as well as assets. This lets the UI distinguish between loading, readiness, and a failure that needs another attempt.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"SkyAssetCache"},{"text":" prepares the sky texture and cloud models. ","type":"text"},{"type":"codeVoice","code":"RealityKit"},{"text":" provides the APIs for 3D assets, and ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":" provides the bundle that contains the clouds.","type":"text"}],"type":"paragraph"}],"code":"SkyAssetCache-00.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"shared"},{"text":" lets multiple views use the same cache. The cache stores asset readiness as well as the assets themselves, including the reason for a failure. ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" keeps this shared state on the main actor.","type":"text"}],"type":"paragraph"}],"code":"SkyAssetCache-01.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"The sky and two clouds are originals that the immersive view clones for display. ","type":"text"},{"type":"codeVoice","code":"private(set)"},{"text":" lets other code read the originals without replacing the cache’s stored values. Views can check ","type":"text"},{"type":"codeVoice","code":"isReady"},{"text":" to find out whether all three assets are available.","type":"text"}],"type":"paragraph"}],"code":"SkyAssetCache-02.swift","caption":[],"runtimePreview":null}],"anchor":"Define-the-cached-assets-and-loading-state","title":"Define the cached assets and loading state"},{"contentSection":[{"media":"cloud_asset_img.png","content":[{"inlineContent":[{"text":"Start loading the sky texture and both cloud models before awaiting their results. With ","type":"text"},{"type":"codeVoice","code":"async let"},{"text":", one file can load while another is still being prepared.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"preload()"},{"text":" handles asset preparation requests in one place. If the assets are ready, it returns immediately. If loading is already in progress, it awaits the task stored in ","type":"text"},{"type":"codeVoice","code":"loadingTask"},{"text":". Sharing that task avoids loading the same files again.","type":"text"}],"type":"paragraph"}],"code":"SkyAssetCache-03.swift","caption":[{"inlineContent":[{"type":"codeVoice","code":"Task<Void, Error>?"},{"text":" stores an optional task that completes without a return value or throws an error. A value of ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" means no task is currently stored.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"The sky and cloud models A and B are independent files, so ","type":"text"},{"type":"codeVoice","code":"async let"},{"text":" can start their loading operations together. One asset can be prepared while another is still loading.","type":"text"}],"type":"paragraph"}],"code":"SkyAssetCache-04a.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Apply the loaded texture to a large sphere to surround the person with a sky. ","type":"text"},{"type":"codeVoice","code":"UnlitMaterial"},{"text":" preserves the background image’s brightness without scene lighting. A scale of ","type":"text"},{"type":"codeVoice","code":"-1"},{"text":" on the x-axis reverses the sphere’s face orientation so the sky is visible from inside.","type":"text"}],"type":"paragraph"}],"code":"SkyAssetCache-04.swift","caption":[{"inlineContent":[{"text":"The cache changes to ","type":"text"},{"type":"codeVoice","code":".ready"},{"text":" only after storing the sky and both cloud originals. Views can then check readiness before using the assets.","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Report whether asset preparation succeeded or failed to the requesting view. On success, clear the task reference and retain the prepared originals for reuse. On failure, clear the originals and propagate the error so the UI can explain the problem and offer another attempt.","type":"text"}],"type":"paragraph"}],"code":"SkyAssetCache-05.swift","caption":[],"runtimePreview":null}],"anchor":"Load-assets-concurrently-without-duplicate-requests","title":"Load assets concurrently without duplicate requests"}]},{"abstract":[{"text":"Place the cached sky and clouds in a 3D environment. Use ","type":"text"},{"code":"RealityView","type":"codeVoice"},{"text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion.","type":"text"}],"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Build the immersive content","action":{"isActive":true,"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]}}],"kind":"project","metadata":{"categoryPathComponent":"2026TechMap_tutorial","role":"project","title":"Preload and cache assets","category":"OvertheCloud"},"variants":[{"paths":["\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache","interfaceLanguage":"swift"},"hierarchy":{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","modules":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-Set-up-the-project-and-assets","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","sections":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets","kind":"task"},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Add-the-sky-texture-and-cloud-models-to-Xcode","kind":"task"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.-Model-the-app-state","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","sections":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel#Create-an-observable-state-model","kind":"task"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/3.-Preload-and-cache-assets","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache","sections":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state","kind":"task"},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Load-