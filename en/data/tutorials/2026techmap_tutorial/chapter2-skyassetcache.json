ials\/2026TechMap_tutorial\/4.-Build-the-immersive-content","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/5.-Build-the-main-window-and-transitions","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Display-the-asset-loading-state"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Create-the-space-toggle-and-error-messages"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Open-and-close-the-immersive-space"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/6.-Configure-the-app-entry-point","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp#Register-the-window-and-immersive-space"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp#Explore-the-completed-app"}]}]}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"project","variants":[{"paths":["\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"project","category":"OvertheCloud","categoryPathComponent":"2026TechMap_tutorial","title":"Preload and cache assets"},"sections":[{"estimatedTimeInMinutes":20,"kind":"hero","title":"Preload and cache assets","chapter":"3. Preload and cache assets","backgroundImage":"ch_thumbnail.png","image":"ch_thumbnail.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}]}]},{"tasks":[{"anchor":"Define-the-cached-assets-and-loading-state","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"The cache stores loading state as well as assets. This lets the UI distinguish between loading, readiness, and a failure that needs another attempt."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"title":"Define the cached assets and loading state","stepsSection":[{"type":"step","code":"SkyAssetCache-00.swift","media":null,"content":[{"inlineContent":[{"code":"SkyAssetCache","type":"codeVoice"},{"type":"text","text":" prepares the sky texture and cloud models. "},{"code":"RealityKit","type":"codeVoice"},{"type":"text","text":" provides the APIs for 3D assets, and "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":" provides the bundle that contains the clouds."}],"type":"paragraph"}],"runtimePreview":null,"caption":[]},{"type":"step","code":"SkyAssetCache-01.swift","media":null,"content":[{"inlineContent":[{"code":"shared","type":"codeVoice"},{"type":"text","text":" lets multiple views use the same cache. The cache stores asset readiness as well as the assets themselves, including the reason for a failure. "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" keeps this shared state on the main actor."}],"type":"paragraph"}],"runtimePreview":null,"caption":[]},{"type":"step","code":"SkyAssetCache-02.swift","media":null,"content":[{"inlineContent":[{"type":"text","text":"The sky and two clouds are originals that the immersive view clones for display. "},{"code":"private(set)","type":"codeVoice"},{"type":"text","text":" lets other code read the originals without replacing the cache’s stored values. Views can check "},{"code":"isReady","type":"codeVoice"},{"type":"text","text":" to find out whether all three assets are available."}],"type":"paragraph"}],"runtimePreview":null,"caption":[]}]},{"anchor":"Load-assets-concurrently-without-duplicate-requests","contentSection":[{"media":"cloud_asset_img.png","content":[{"inlineContent":[{"type":"text","text":"Start loading the sky texture and both cloud models before awaiting their results. With "},{"code":"async let","type":"codeVoice"},{"type":"text","text":", one file can load while another is still being prepared."}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"title":"Load assets concurrently without duplicate requests","stepsSection":[{"type":"step","code":"SkyAssetCache-03.swift","media":null,"content":[{"inlineContent":[{"code":"preload()","type":"codeVoice"},{"type":"text","text":" handles asset preparation requests in one place. If the assets are ready, it returns immediately. If loading is already in progress, it awaits the task stored in "},{"code":"loadingTask","type":"codeVoice"},{"type":"text","text":". Sharing that task avoids loading the same files again."}],"type":"paragraph"}],"runtimePreview":null,"caption":[{"inlineContent":[{"code":"Task<Void, Error>?","type":"codeVoice"},{"type":"text","text":" stores an optional task that completes without a return value or throws an error. A value of "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" means no task is currently stored."}],"type":"paragraph"}]},{"type":"step","code":"SkyAssetCache-04a.swift","media":null,"content":[{"inlineContent":[{"type":"text","text":"The sky and cloud models A and B are independent files, so "},{"code":"async let","type":"codeVoice"},{"type":"text","text":" can start their loading operations together. One asset can be prepared while another is still loading."}],"type":"paragraph"}],"runtimePreview":null,"caption":[]},{"type":"step","code":"SkyAssetCache-04.swift","media":null,"content":[{"inlineContent":[{"type":"text","text":"Apply the loaded texture to a large sphere to surround the person with a sky. "},{"code":"UnlitMaterial","type":"codeVoice"},{"type":"text","text":" preserves the background image’s brightness without scene lighting. A scale of "},{"code":"-1","type":"codeVoice"},{"type":"text","text":" on the x-axis reverses the sphere’s face orientation so the sky is visible from inside."}],"type":"paragraph"}],"runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"The cache changes to "},{"code":".ready","type":"codeVoice"},{"type":"text","text":" only after storing the sky and both cloud originals. Views can then check readiness before using the assets."}],"type":"paragraph"}]},{"type":"step","code":"SkyAssetCache-05.swift","media":null,"content":[{"inlineContent":[{"type":"text","text":"Report whether asset preparation succeeded or failed to the requesting view. On success, clear the task reference and retain the prepared originals for reuse. On failure, clear the originals and propagate the error so the UI can explain the problem and offer another attempt."}],"type":"paragraph"}],"runtimePreview":null,"caption":[]}]}],"kind":"tasks"},{"abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}],"featuredEyebrow":"Tutorial","kind":"callToAction","action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","type":"reference","isActive":true,"overridingTitle":"Get started"},"title":"Build the immersive content"}],"references":{"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","kind":"overview","url":"\/tutorials\/2026techmap_tutorial","title":"Build an Immersive Space Above the Clouds","type":"topic","role":"overview","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":" in visionOS to build an immersive environment that feels like floating among clouds."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#Define-the-cached-assets-and-loading-state","title":"Define the cached assets and loading state","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Animate-the-clouds":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Animate-the-clouds","title":"Animate the clouds","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Place-the-sky-sphere-and-clouds","title":"Place the sky sphere and clouds","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}]},"ch_thumbnail.png":{"identifier":"ch_thumbnail.png","alt":"A blue sky and clouds behind the chapter heading","variants":[{"traits":["1x","light"],"url":"\/images\/2026TechMap_tutorial\/ch_thumbnail.png"}],"type":"image"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/2.-Model-the-app-state":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.-Model-the-app-state","kind":"article","title":"2. Model the app state","url":"\/tutorials\/2026techmap_tutorial\/2.-model-the-app-state","type":"topic","role":"article","abstract":[]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/5.-Build-the-main-window-and-transitions":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/5.-Build-the-main-window-and-transitions","kind":"article","title":"5. Build the main window and transitions","url":"\/tutorials\/2026techmap_tutorial\/5.-build-the-main-window-and-transitions","type":"topic","role":"article","abstract":[]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","kind":"project","estimatedTime":"15min","title":"Set up the project and assets","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup","type":"topic","role":"project","abstract":[{"text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract ","type":"text"},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"text":" from ","type":"text"},{"type":"strong","inlineContent":[{"text":"Project files","type":"text"}]},{"text":" below, then connect the texture to the app target and add the package as a dependency.","type":"text"}]},"SkyAssetCache-05.swift":{"syntax":"swift","identifier":"SkyAssetCache-05.swift","fileName":"SkyAssetCache.swift","type":"file","fileType":"swift","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","            let (texture, loadedCloudA, loadedCloudB) = try await (","                skyTexture,","                cloudA,","                cloudB","            )","","            var material = UnlitMaterial()","            material.color = .init(tint: .white, texture: .init(texture))","","            let skyMesh = MeshResource.generateSphere(radius: 100)","            let skyEntity = ModelEntity(mesh: skyMesh, materials: [material])","            skyEntity.scale = SIMD3<Float>(-1, 1, 1)","","            skyEntityTemplate = skyEntity","            cloudATemplate = loadedCloudA","            cloudBTemplate = loadedCloudB","            state = .ready","        }","","        loadingTask = task","","        do {","            try await task.value","            loadingTask = nil","        } catch {","            loadingTask = nil","            skyEntityTemplate = nil","            cloudATemplate = nil","            cloudBTemplate = nil","            state = .failed(error.localizedDescription)","            throw error","        }","    }","}"],"highlights":[{"line":68},{"line":69},{"line":70},{"line":71},{"line":72},{"line":73},{"line":74},{"line":75},{"line":76},{"line":77},{"line":78},{"line":79}]},"SkyAssetCache-01.swift":{"syntax":"swift","identifier":"SkyAssetCache-01.swift","fileName":"SkyAssetCache.swift","type":"file","fileType":"swift","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","}"],"highlights":[{"line":5},{"line":7},{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":16}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets":{"kind":"section","title":"Create a visionOS app and download the assets","abstract":[{"type":"text","text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Sw