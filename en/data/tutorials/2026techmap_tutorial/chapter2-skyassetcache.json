pe":"file","highlights":[{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50}],"syntax":"swift","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","        }","","        loadingTask = task","    }","}"],"fileName":"SkyAssetCache.swift","fileType":"swift","identifier":"SkyAssetCache-04a.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup#Add-the-sky-texture-and-cloud-models-to-Xcode":{"abstract":[{"type":"text","text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract "},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"type":"text","text":" from "},{"inlineContent":[{"text":"Project files","type":"text"}],"type":"strong"},{"type":"text","text":" below, then connect the texture to the app target and add the package as a dependency."}],"type":"section","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Add-the-sky-texture-and-cloud-models-to-Xcode","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup#Add-the-sky-texture-and-cloud-models-to-Xcode","title":"Add the sky texture and cloud models to Xcode","kind":"section","role":"pseudoSymbol"},"SkyAssetCache-04.swift":{"type":"file","highlights":[{"line":48},{"line":49},{"line":50},{"line":51},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":62},{"line":63},{"line":64}],"syntax":"swift","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","            let (texture, loadedCloudA, loadedCloudB) = try await (","                skyTexture,","                cloudA,","                cloudB","            )","","            var material = UnlitMaterial()","            material.color = .init(tint: .white, texture: .init(texture))","","            let skyMesh = MeshResource.generateSphere(radius: 100)","            let skyEntity = ModelEntity(mesh: skyMesh, materials: [material])","            skyEntity.scale = SIMD3<Float>(-1, 1, 1)","","            skyEntityTemplate = skyEntity","            cloudATemplate = loadedCloudA","            cloudBTemplate = loadedCloudB","            state = .ready","        }","","        loadingTask = task","    }","}"],"fileName":"SkyAssetCache.swift","fileType":"swift","identifier":"SkyAssetCache-04.swift"}}}