 State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","    }","}"],"highlights":[{"line":22},{"line":23},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41}],"identifier":"SkyAssetCache-03.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/1.-Set-up-the-project-and-assets":{"role":"article","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/1.-set-up-the-project-and-assets","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-Set-up-the-project-and-assets","title":"1. Set up the project and assets","abstract":[],"kind":"article"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial":{"role":"overview","type":"topic","url":"\/tutorials\/2026techmap_tutorial","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","title":"Build an Immersive Space Above the Clouds","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":" in visionOS to build an immersive environment that feels like floating among clouds."}],"kind":"overview"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets":{"role":"pseudoSymbol","type":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup#Create-a-visionOS-app-and-download-the-assets","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets","title":"Create a visionOS app and download the assets","abstract":[{"type":"text","text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract "},{"type":"codeVoice","code":"OvertheCloud-Assets.zip"},{"type":"text","text":" from "},{"type":"strong","inlineContent":[{"text":"Project files","type":"text"}]},{"type":"text","text":" below, then connect the texture to the app target and add the package as a dependency."}],"kind":"section"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Animate-the-clouds":{"role":"pseudoSymbol","type":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Animate-the-clouds","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds","title":"Animate the clouds","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}],"kind":"section"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter4-ContentView#Open-and-close-the-immersive-space":{"role":"pseudoSymbol","type":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter4-contentview#Open-and-close-the-immersive-space","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Open-and-close-the-immersive-space","title":"Open and close the immersive space","abstract":[{"type":"text","text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps."}],"kind":"section"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache":{"estimatedTime":"20min","role":"project","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache","title":"Preload and cache assets","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}],"kind":"project"},"SkyAssetCache-01.swift":{"content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","}"],"syntax":"swift","fileName":"SkyAssetCache.swift","type":"file","fileType":"swift","highlights":[{"line":5},{"line":7},{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":16}],"identifier":"SkyAssetCache-01.swift"},"ch_thumbnail.png":{"type":"image","identifier":"ch_thumbnail.png","alt":"A blue sky and clouds behind the chapter heading","variants":[{"traits":["1x","light"],"url":"\/images\/2026TechMap_tutorial\/ch_thumbnail.png"}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state":{"role":"pseudoSymbol","type":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#Define-the-cached-assets-and-loading-state","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state","title":"Define the cached assets and loading state","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}],"kind":"section"},"SkyAssetCache-05.swift":{"fileType":"swift","syntax":"swift","fileName":"SkyAssetCache.swift","type":"file","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","            let (texture, loadedCloudA, loadedCloudB) = try await (","                skyTexture,","                cloudA,","                cloudB","            )","","            var material = UnlitMaterial()","            material.color = .init(tint: .white, texture: .init(texture))","","            let skyMesh = MeshResource.generateSphere(radius: 100)","            let skyEntity = ModelEntity(mesh: skyMesh, materials: [material])","            skyEntity.scale = SIMD3<Float>(-1, 1, 1)","","            skyEntityTemplate = skyEntity","            cloudATemplate = loadedCloudA","            cloudBTemplate = loadedCloudB","            state = .ready","        }","","        loadingTask = task","","        do {","            try await task.value","            loadingTask = nil","        } catch {","            loadingTask = nil","            skyEntityTemplate = nil","            cloudATemplate = nil","            cloudBTemplate = nil","            state = .failed(error.localizedDescription)","            throw error","        }","    }","}"],"highlights":[{"line":68},{"line":69},{"line":70},{"line":71},{"line":72},{"line":73},{"line":74},{"line":75},{"line":76},{"line":77},{"line":78},{"line":79}],"identifier":"SkyAssetCache-05.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/4.-Build-the-immersive-content":{"role":"article","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/4.-build-the-immersive-content","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/4.-Build-the-immersive-content","title":"4. Build the immersive content","abstract":[],"kind":"article"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#Load-assets-concurrently-without-duplicate-requests":{"role":"pseudoSymbol","type":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#Load-assets-concurrently-without-duplicate-requests","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Load-assets-concurrently-without-duplicate-requests","title":"Load assets concurrently without duplicate requests","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}],"kind":"section"},