 State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","        }","","        loadingTask = task","    }","}"],"highlights":[{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50}]},"cloud_asset_img.png":{"identifier":"cloud_asset_img.png","alt":"Cloud assets in Reality Composer Pro","variants":[{"traits":["1x","light"],"url":"\/images\/2026TechMap_tutorial\/cloud_asset_img.png"}],"type":"image"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#Load-assets-concurrently-without-duplicate-requests":{"kind":"section","title":"Load assets concurrently without duplicate requests","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}],"type":"section","role":"pseudoSymbol","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Load-assets-concurrently-without-duplicate-requests","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#Load-assets-concurrently-without-duplicate-requests"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","kind":"project","estimatedTime":"20min","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview","title":"Build the immersive content","type":"topic","role":"project","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter4-ContentView#Create-the-space-toggle-and-error-messages":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Create-the-space-toggle-and-error-messages","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter4-contentview#Create-the-space-toggle-and-error-messages","title":"Create the space toggle and error messages","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps."}]},"SkyAssetCache-04.swift":{"syntax":"swift","identifier":"SkyAssetCache-04.swift","fileName":"SkyAssetCache.swift","type":"file","fileType":"swift","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","            let (texture, loadedCloudA, loadedCloudB) = try await (","                skyTexture,","                cloudA,","                cloudB","            )","","            var material = UnlitMaterial()","            material.color = .init(tint: .white, texture: .init(texture))","","            let skyMesh = MeshResource.generateSphere(radius: 100)","            let skyEntity = ModelEntity(mesh: skyMesh, materials: [material])","            skyEntity.scale = SIMD3<Float>(-1, 1, 1)","","            skyEntityTemplate = skyEntity","            cloudATemplate = loadedCloudA","            cloudBTemplate = loadedCloudB","            state = .ready","        }","","        loadingTask = task","    }","}"],"highlights":[{"line":48},{"line":49},{"line":50},{"line":51},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56},{"line":57},{"line":58},{"line":59},{"line":60},{"line":61},{"line":62},{"line":63},{"line":64}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter1-AppModel#Create-an-observable-state-model":{"identifier":"doc:\/\/2026TechMap_