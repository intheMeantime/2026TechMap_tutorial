":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41}],"syntax":"swift","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","    }","}"],"fileName":"SkyAssetCache.swift","fileType":"swift","identifier":"SkyAssetCache-03.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/4.-Build-the-immersive-content":{"abstract":[],"type":"topic","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/4.-Build-the-immersive-content","url":"\/tutorials\/2026techmap_tutorial\/4.-build-the-immersive-content","title":"4. Build the immersive content","kind":"article","role":"article"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets":{"abstract":[{"type":"text","text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract "},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"type":"text","text":" from "},{"inlineContent":[{"text":"Project files","type":"text"}],"type":"strong"},{"type":"text","text":" below, then connect the texture to the app target and add the package as a dependency."}],"type":"section","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup#Create-a-visionOS-app-and-download-the-assets","title":"Create a visionOS app and download the assets","kind":"section","role":"pseudoSymbol"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Animate-the-clouds":{"abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"code":"RealityView","type":"codeVoice"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}],"type":"section","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Animate-the-clouds","title":"Animate the clouds","kind":"section","role":"pseudoSymbol"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter4-ContentView#Create-the-space-toggle-and-error-messages":{"abstract":[{"type":"text","text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps."}],"type":"section","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Create-the-space-toggle-and-error-messages","url":"\/tutorials\/2026techmap_tutorial\/chapter4-contentview#Create-the-space-toggle-and-error-messages","title":"Create the space toggle and error messages","kind":"section","role":"pseudoSymbol"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter4-ContentView#Display-the-asset-loading-state":{"abstract":[{"type":"text","text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps."}],"type":"section","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Display-the-asset-loading-state","url":"\/tutorials\/2026techmap_tutorial\/chapter4-contentview#Display-the-asset-loading-state","title":"Display the asset loading state","kind":"section","role":"pseudoSymbol"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds":{"abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"code":"RealityView","type":"codeVoice"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}],"type":"section","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Place-the-sky-sphere-and-clouds","title":"Place the sky sphere and clouds","kind":"section","role":"pseudoSymbol"},"cloud_asset_img.png":{"alt":"Cloud assets in Reality Composer Pro","variants":[{"url":"\/images\/2026TechMap_tutorial\/cloud_asset_img.png","traits":["1x","light"]}],"type":"image","identifier":"cloud_asset_img.png"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView":{"abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"code":"RealityView","type":"codeVoice"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}],"type":"topic","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview","title":"Build the immersive content","kind":"project","role":"project","estimatedTime":"20min"},"SkyAssetCache-05.swift":{"type":"file","highlights":[{"line":68},{"line":69},{"line":70},{"line":71},{"line":72},{"line":73},{"line":74},{"line":75},{"line":76},{"line":77},{"line":78},{"line":79}],"syntax":"swift","content":["import RealityKit","import UIKit","import cloudpractice","","@MainActor","final class SkyAssetCache {","    static let shared = SkyAssetCache()","","    enum State {","        case idle","        case loading","        case ready","        case failed(String)","    }","","    private(set) var state: State = .idle","","    private(set) var skyEntityTemplate: Entity?","    private(set) var cloudATemplate: Entity?","    private(set) var cloudBTemplate: Entity?","","    private var loadingTask: Task<Void, Error>?","","    var isReady: Bool {","        if case .ready = state {","            return true","        }","        return false","    }","","    func preload() async throws {","        if isReady {","            return","        }","","        if let loadingTask {","            try await loadingTask.value","            return","        }","","        state = .loading","","        let task = Task { @MainActor in","            async let skyTexture = TextureResource(named: \"skyBg_ASTC.ktx\")","            async let cloudA = Entity(named: \"Cloud_A\", in: cloudpracticeBundle)","            async let cloudB = Entity(named: \"Cloud_B\", in: cloudpracticeBundle)","","            let (texture, loadedCloudA, loadedCloudB) = try await (","                skyTexture,","                cloudA,","                cloudB","            )","","            var material = UnlitMaterial()","            material.color = .init(tint: .white, texture: .init(texture))","","            let skyMesh = MeshResource.generateSphere(radius: 100)","            let skyEntity = ModelEntity(mesh: skyMesh, materials: [material])","            skyEntity.scale = SIMD3<Float>(-1, 1, 1)","","            skyEntityTemplate = skyEntity","            cloudATemplate = loadedCloudA","            cloudBTemplate = loadedCloudB","            state = .ready","        }","","        loadingTask = task","","        do {","            try await task.value","            loadingTask = nil","        } catch {","            loadingTask = nil","            skyEntityTemplate = nil","            cloudATemplate = nil","            cloudBTemplate = nil","            state = .failed(error.localizedDescription)","            throw error","        }","    }","}"],"fileName":"SkyAssetCache.swift","fileType":"swift","identifier":"SkyAssetCache-05.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter5-OvertheCloudApp":{"abstract":[{"type":"text","text":"Connect "},{"code":"AppModel","type":"codeVoice"},{"type":"text","text":", "},{"code":"ContentView","type":"codeVoice"},{"type":"text","text":", and "},{"code":"ImmersiveView","type":"codeVoice"},{"type":"text","text":" in the app entry point. Register a "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":" and an "},{"code":"ImmersiveSpace","type":"codeVoice"},{"type":"text","text":", and configure the space to use the fully immersive ("},{"code":"full","type":"codeVoice"},{"type":"text","text":") style."}],"type":"topic","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp","url":"\/tutorials\/2026techmap_tutorial\/chapter5-overthecloudapp","title":"Configure the app entry point","kind":"project","role":"project","estimatedTime":"5min"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache":{"abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"code":"SkyAssetCache","type":"codeVoice"},{"type":"text","text":" that prepares these assets when the main window appears."}],"type":"topic","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache","url":"\/tutorials\/2026techmap_tutorial\/chapter2-