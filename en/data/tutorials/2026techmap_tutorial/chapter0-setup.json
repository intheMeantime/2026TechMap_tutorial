{"sections":[{"chapter":"1. Set up the project and assets","xcodeRequirement":"Xcode 26 or later","image":"ch_thumbnail.png","content":[{"inlineContent":[{"text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract ","type":"text"},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"text":" from ","type":"text"},{"inlineContent":[{"type":"text","text":"Project files"}],"type":"strong"},{"text":" below, then connect the texture to the app target and add the package as a dependency.","type":"text"}],"type":"paragraph"}],"backgroundImage":"ch_thumbnail.png","estimatedTimeInMinutes":15,"title":"Set up the project and assets","kind":"hero","projectFiles":"OvertheCloud-Assets.zip"},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"inlineContent":[{"text":"The following steps assume a new SwiftUI visionOS app. You can also use an existing project, but set its minimum deployment target to visionOS 26 or later to match the supplied ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":" package.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":"ch1_1_create.png","type":"step","content":[{"inlineContent":[{"text":"In Xcode, choose ","type":"text"},{"type":"strong","inlineContent":[{"text":"File ▸ New ▸ Project ▸ visionOS ▸ App","type":"text"}]},{"text":" to create a visionOS app.","type":"text"}],"type":"paragraph"}],"code":null,"caption":[],"runtimePreview":null},{"media":"ch1_2_create_name.png","type":"step","content":[{"inlineContent":[{"text":"Set the product name to ","type":"text"},{"type":"codeVoice","code":"OvertheCloud"},{"text":". Using the same name keeps file names and target selections consistent with the examples that follow.","type":"text"}],"type":"paragraph"}],"code":null,"caption":[],"runtimePreview":null},{"media":"ch1_3_files.png","type":"step","content":[{"inlineContent":[{"text":"The tutorial provides the sky texture and cloud models. Download ","type":"text"},{"type":"codeVoice","code":"OvertheCloud-Assets.zip"},{"text":" from ","type":"text"},{"type":"strong","inlineContent":[{"text":"Project files","type":"text"}]},{"text":" and extract it to find the sky texture, ","type":"text"},{"type":"codeVoice","code":"skyBg_ASTC.ktx"},{"text":", and the local Swift package, ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":".","type":"text"}],"type":"paragraph"}],"code":null,"caption":[{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"The code locates assets by their file names and entity names. Keep the supplied names and folder structure unchanged.","type":"text"}]}]}],"runtimePreview":null}],"anchor":"Create-a-visionOS-app-and-download-the-assets","title":"Create a visionOS app and download the assets"},{"contentSection":[{"media":"ch1_4_start.png","content":[{"inlineContent":[{"text":"The sky texture belongs in the main app bundle. The cloud models belong to the separate ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":" module. Both connections are required for asset preloading to succeed.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":"ch1_5_add.png","type":"step","content":[{"inlineContent":[{"text":"Drag ","type":"text"},{"type":"codeVoice","code":"skyBg_ASTC.ktx"},{"text":" into the ","type":"text"},{"type":"codeVoice","code":"OvertheCloud"},{"text":" app group in the Xcode project navigator to include the sky texture in the app.","type":"text"}],"type":"paragraph"}],"code":null,"caption":[],"runtimePreview":null},{"media":"ch1_5.png","type":"step","content":[{"inlineContent":[{"text":"Copying the file into the project and adding it to the app target lets the app load the sky without relying on the original file location. In the sheet, select ","type":"text"},{"type":"strong","inlineContent":[{"text":"Copy files to destination","type":"text"}]},{"text":" and the ","type":"text"},{"type":"codeVoice","code":"OvertheCloud"},{"text":" target, then choose ","type":"text"},{"type":"strong","inlineContent":[{"text":"Finish","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}],"code":null,"caption":[],"runtimePreview":null},{"media":"ch1_6_skyimg.png","type":"step","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Target Membership","type":"text"}]},{"text":" determines which app includes the texture. Select ","type":"text"},{"type":"codeVoice","code":"OvertheCloud"},{"text":" in the File inspector so the running app can find the texture in its bundle.","type":"text"}],"type":"paragraph"}],"code":null,"caption":[],"runtimePreview":null},{"media":"ch1_7_pkg.png","type":"step","content":[{"inlineContent":[{"text":"The downloaded ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":" package provides the cloud models and their resource bundle. Choose ","type":"text"},{"type":"strong","inlineContent":[{"text":"File ▸ Add Package Dependencies ▸ Add Local","type":"text"}]},{"text":", then select the extracted ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":" folder to make those assets available to the app.","type":"text"}],"type":"paragraph"}],"code":null,"caption":[],"runtimePreview":null},{"media":"ch1_8_pkg2.png","type":"step","content":[{"inlineContent":[{"text":"Connecting the package to the ","type":"text"},{"type":"codeVoice","code":"OvertheCloud"},{"text":" app target makes the ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":" module and its assets available in code. Later, the app uses ","type":"text"},{"type":"codeVoice","code":"Cloud_A"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Cloud_B"},{"text":" to create clouds with different shapes.","type":"text"}],"type":"paragraph"}],"code":null,"caption":[],"runtimePreview":null},{"media":"ch1_9_fin.png","type":"step","content":[{"inlineContent":[{"text":"Confirm that the sky texture appears in the project navigator and ","type":"text"},{"type":"codeVoice","code":"cloudpractice"},{"text":" appears under ","type":"text"},{"type":"strong","inlineContent":[{"text":"Package Dependencies","type":"text"}]},{"text":". Both must be available before the cache can load the sky and clouds.","type":"text"}],"type":"paragraph"}],"code":null,"caption":[{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"If Xcode reports ","type":"text"},{"type":"codeVoice","code":"No such module"},{"text":", check that the package is connected to the app target. If the texture cannot be found, check its file name and Target Membership.","type":"text"}]}]}],"runtimePreview":null}],"anchor":"Add-the-sky-texture-and-cloud-models-to-Xcode","title":"Add the sky texture and cloud models to Xcode"}]},{"abstract":[{"text":"A window and an immersive view need shared state to coordinate their behavior. Create an ","type":"text"},{"code":"AppModel","type":"codeVoice"},{"text":" that uses the ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" macro to represent the state of the immersive space.","type":"text"}],"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Model the app state","action":{"isActive":true,"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]}}],"identifier":{"url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","interfaceLanguage":"swift"},"hierarchy":{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","modules":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-Set-up-the-project-and-assets","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutori