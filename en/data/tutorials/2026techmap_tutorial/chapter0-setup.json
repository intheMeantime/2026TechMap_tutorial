code 26 or later","projectFiles":"OvertheCloud-Assets.zip","estimatedTimeInMinutes":15,"title":"Set up the project and assets","backgroundImage":"ch_thumbnail.png","kind":"hero","image":"ch_thumbnail.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract "},{"type":"codeVoice","code":"OvertheCloud-Assets.zip"},{"type":"text","text":" from "},{"inlineContent":[{"type":"text","text":"Project files"}],"type":"strong"},{"type":"text","text":" below, then connect the texture to the app target and add the package as a dependency."}]}]},{"tasks":[{"stepsSection":[{"code":null,"content":[{"inlineContent":[{"type":"text","text":"In Xcode, choose "},{"inlineContent":[{"text":"File ▸ New ▸ Project ▸ visionOS ▸ App","type":"text"}],"type":"strong"},{"type":"text","text":" to create a visionOS app."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_1_create.png","caption":[]},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"Set the product name to "},{"code":"OvertheCloud","type":"codeVoice"},{"type":"text","text":". Using the same name keeps file names and target selections consistent with the examples that follow."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_2_create_name.png","caption":[]},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"The tutorial provides the sky texture and cloud models. Download "},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"type":"text","text":" from "},{"inlineContent":[{"text":"Project files","type":"text"}],"type":"strong"},{"type":"text","text":" and extract it to find the sky texture, "},{"code":"skyBg_ASTC.ktx","type":"codeVoice"},{"type":"text","text":", and the local Swift package, "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_3_files.png","caption":[{"content":[{"inlineContent":[{"text":"The code locates assets by their file names and entity names. Keep the supplied names and folder structure unchanged.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"}]}],"anchor":"Create-a-visionOS-app-and-download-the-assets","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"The following steps assume a new SwiftUI visionOS app. You can also use an existing project, but set its minimum deployment target to visionOS 26 or later to match the supplied "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":" package."}],"type":"paragraph"}],"mediaPosition":"trailing"}],"title":"Create a visionOS app and download the assets"},{"stepsSection":[{"code":null,"content":[{"inlineContent":[{"type":"text","text":"Drag "},{"code":"skyBg_ASTC.ktx","type":"codeVoice"},{"type":"text","text":" into the "},{"code":"OvertheCloud","type":"codeVoice"},{"type":"text","text":" app group in the Xcode project navigator to include the sky texture in the app."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_5_add.png","caption":[]},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"Copying the file into the project and adding it to the app target lets the app load the sky without relying on the original file location. In the sheet, select "},{"inlineContent":[{"text":"Copy files to destination","type":"text"}],"type":"strong"},{"type":"text","text":" and the "},{"code":"OvertheCloud","type":"codeVoice"},{"type":"text","text":" target, then choose "},{"inlineContent":[{"text":"Finish","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_5.png","caption":[]},{"code":null,"content":[{"inlineContent":[{"inlineContent":[{"text":"Target Membership","type":"text"}],"type":"strong"},{"type":"text","text":" determines which app includes the texture. Select "},{"code":"OvertheCloud","type":"codeVoice"},{"type":"text","text":" in the File inspector so the running app can find the texture in its bundle."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_6_skyimg.png","caption":[]},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"The downloaded "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":" package provides the cloud models and their resource bundle. Choose "},{"inlineContent":[{"text":"File ▸ Add Package Dependencies ▸ Add Local","type":"text"}],"type":"strong"},{"type":"text","text":", then select the extracted "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":" folder to make those assets available to the app."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_7_pkg.png","caption":[]},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"Connecting the package to the "},{"code":"OvertheCloud","type":"codeVoice"},{"type":"text","text":" app target makes the "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":" module and its assets available in code. Later, the app uses "},{"code":"Cloud_A","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Cloud_B","type":"codeVoice"},{"type":"text","text":" to create clouds with different shapes."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_8_pkg2.png","caption":[]},{"code":null,"content":[{"inlineContent":[{"type":"text","text":"Confirm that the sky texture appears in the project navigator and "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":" appears under "},{"inlineContent":[{"text":"Package Dependencies","type":"text"}],"type":"strong"},{"type":"text","text":". Both must be available before the cache can load the sky and clouds."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"media":"ch1_9_fin.png","caption":[{"content":[{"inlineContent":[{"text":"If Xcode reports ","type":"text"},{"code":"No such module","type":"codeVoice"},{"text":", check that the package is connected to the app target. If the texture cannot be found, check its file name and Target Membership.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"}]}],"anchor":"Add-the-sky-texture-and-cloud-models-to-Xcode","contentSection":[{"kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"The sky texture belongs in the main app bundle. The cloud models belong to the separate "},{"code":"cloudpractice","type":"codeVoice"},{"type":"text","text":" module. Both connections are required for asset preloading to succeed."}],"type":"paragraph"}],"mediaPosition":"trailing","media":"ch1_4_start.png"}],"title":"Add the sky texture and cloud models to Xcode"}],"kind":"tasks"},{"title":"Model the app state","action":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"overridingTitle":"Get started","type":"reference","isActive":true},"abstract":[{"type":"text","text":"A window and an immersive view need shared state to coordinate their behavior. Create an "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":" that uses the "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" macro to represent the state of the immersive space."}],"kind":"callToAction","featuredEyebrow":"Tutorial"}],"variants":[{"paths":["\/tutorials\/2026techmap_tutorial\/chapter0-setup"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","kind":"overview","url":"\/tutorials\/2026techmap_tutorial","title":"Build an Immersive Space Above the Clouds","type":"topic","role":"overview","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":" in visionOS to build an immersive environment that feels like floating among clouds."}]},"ch1_3_files.png":{"identifier":"ch1_3_files.png","type":"image","alt":"The extracted sky texture and cloudpractice package","variants":[{"url":"\/images\/2026TechMap_tutorial\/ch1_3_files.png","traits":["1x","light"]}]},"OvertheCloud-Assets.zip":{"identifier":"OvertheCloud-Assets.zip","type":"download","checksum":"47b3e0d66cab60db7cce6a341f496a8ef71636600e3f985e5c2ec6ebd600fa805e9be38755fea9f60c694a74b08288d27a1a83e5d30f393b3ebfebe04ab0104a","url":"\/downloads\/2026TechMap_tutorial\/OvertheCloud-Assets.zip"},"ch1_2_create_name.png":{"identifier":"ch1_2_create_name.png","type":"image","alt":"The Xcode project options with OvertheCloud as the product name","variants":[{"url":"\/images\/2026TechMap_tutorial\/ch1_2_create_name.png","traits":["1x","light"]}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#Define-the-cached-assets-and-loading-state","title":"Define the cached assets and loading state","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Animate-the-clouds":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapte