rsiveView#Animate-the-clouds","kind":"task"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView"}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/5.-Build-the-main-window-and-transitions","projects":[{"sections":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Display-the-asset-loading-state","kind":"task"},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Create-the-space-toggle-and-error-messages","kind":"task"},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Open-and-close-the-immersive-space","kind":"task"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView"}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/6.-Configure-the-app-entry-point","projects":[{"sections":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp#Register-the-window-and-immersive-space","kind":"task"},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp#Explore-the-completed-app","kind":"task"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp"}]}],"paths":[["doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/$volume","doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.-Model-the-app-state"]],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/2026techmap_tutorial\/chapter1-appmodel"]}],"metadata":{"category":"OvertheCloud","role":"project","title":"Model the app state","categoryPathComponent":"2026TechMap_tutorial"},"sections":[{"estimatedTimeInMinutes":5,"kind":"hero","title":"Model the app state","chapter":"2. Model the app state","backgroundImage":"ch_thumbnail.png","image":"ch_thumbnail.png","content":[{"inlineContent":[{"type":"text","text":"A window and an immersive view need shared state to coordinate their behavior. Create an "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":" that uses the "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" macro to represent the state of the immersive space."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"contentSection":[{"kind":"contentAndMedia","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A visionOS app often needs to share state across scenes such as "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":". The "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" macro lets SwiftUI track changes to properties that a view reads and update the view accordingly."}]}]}],"stepsSection":[{"type":"step","caption":[],"code":"AppModel-01.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppModel"},{"type":"text","text":" stores state shared by the window and immersive view. "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" lets SwiftUI track the state a view reads, while "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" keeps UI-related state on the main actor. Both views can then respond to the same information."}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"AppModel-02.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An immersive view takes time to open and close. The "},{"type":"codeVoice","code":"opening"},{"type":"text","text":" and "},{"type":"codeVoice","code":"closing"},{"type":"text","text":" cases of "},{"type":"codeVoice","code":"ImmersiveSpaceState"},{"type":"text","text":" represent these transitions so the app can temporarily disable the button. The "},{"type":"codeVoice","code":"closed"},{"type":"text","text":" and "},{"type":"codeVoice","code":"open"},{"type":"text","text":" cases indicate when another transition can begin."}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"AppModel-03.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"immersiveSpaceState"},{"type":"text","text":" records the current state of the immersive view. Its initial value, "},{"type":"codeVoice","code":".closed"},{"type":"text","text":", lets the window offer the action to enter the space. The window button and immersive view’s dismissal handling update this same value to keep the UI in sync with the space."}]}],"runtimePreview":null}],"title":"Create an observable state model","anchor":"Create-an-observable-state-model"}]},{"featuredEyebrow":"Tutorial","title":"Preload and cache assets","abstract":[{"text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a ","type":"text"},{"type":"codeVoice","code":"SkyAssetCache"},{"text":" that prepares these assets when the main window appears.","type":"text"}],"kind":"callToAction","action":{"isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache"}}],"references":{"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","kind":"overview","url":"\/tutorials\/2026techmap_tutorial","title":"Build an Immersive Space Above the Clouds","type":"topic","role":"overview","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":" in visionOS to build an immersive environment that feels like floating among clouds."}]},"AppModel-03.swift":{"syntax":"swift","identifier":"AppModel-03.swift","fileName":"AppModel.swift","type":"file","fileType":"swift","content":["import Observation","","@MainActor","@Observable","final class AppModel {","    enum ImmersiveSpaceState {","        case closed","        case opening","        case open","        case closing","    }","","    var immersiveSpaceState: ImmersiveSpaceState = .closed","}"],"highlights":[{"line":12},{"line":13}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#Define-the-cached-assets-and-loading-state","title":"Define the cached assets and loading state","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Animate-the-clouds":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Animate-the-clouds","title":"Animate the clouds","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and giv