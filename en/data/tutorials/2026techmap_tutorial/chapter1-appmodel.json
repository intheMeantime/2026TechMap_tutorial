{"sections":[{"chapter":"2. Model the app state","image":"ch_thumbnail.png","content":[{"inlineContent":[{"type":"text","text":"A window and an immersive view need shared state to coordinate their behavior. Create an "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":" that uses the "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" macro to represent the state of the immersive space."}],"type":"paragraph"}],"backgroundImage":"ch_thumbnail.png","estimatedTimeInMinutes":5,"title":"Model the app state","kind":"hero"},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"inlineContent":[{"text":"A visionOS app often needs to share state across scenes such as ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ImmersiveSpace"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" macro lets SwiftUI track changes to properties that a view reads and update the view accordingly.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"AppModel"},{"text":" stores state shared by the window and immersive view. ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" lets SwiftUI track the state a view reads, while ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" keeps UI-related state on the main actor. Both views can then respond to the same information.","type":"text"}],"type":"paragraph"}],"code":"AppModel-01.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"An immersive view takes time to open and close. The ","type":"text"},{"type":"codeVoice","code":"opening"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"closing"},{"text":" cases of ","type":"text"},{"type":"codeVoice","code":"ImmersiveSpaceState"},{"text":" represent these transitions so the app can temporarily disable the button. The ","type":"text"},{"type":"codeVoice","code":"closed"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"open"},{"text":" cases indicate when another transition can begin.","type":"text"}],"type":"paragraph"}],"code":"AppModel-02.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"immersiveSpaceState"},{"text":" records the current state of the immersive view. Its initial value, ","type":"text"},{"type":"codeVoice","code":".closed"},{"text":", lets the window offer the action to enter the space. The window button and immersive view’s dismissal handling update this same value to keep the UI in sync with the space.","type":"text"}],"type":"paragraph"}],"code":"AppModel-03.swift","caption":[],"runtimePreview":null}],"anchor":"Create-an-observable-state-model","title":"Create an observable state model"}]},{"abstract":[{"text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a ","type":"text"},{"code":"SkyAssetCache","type":"codeVoice"},{"text":" that prepares these assets when the main window appears.","type":"text"}],"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Preload and cache assets","action":{"isActive":true,"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]}}],"identifier":{"url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","interfaceLanguage":"swift"},"hierarchy":{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","modules":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-Set-up-the-project-and-assets","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\