{"kind":"project","sections":[{"backgroundImage":"ch_thumbnail.png","kind":"hero","estimatedTimeInMinutes":5,"image":"ch_thumbnail.png","title":"Model the app state","content":[{"inlineContent":[{"text":"A window and an immersive view need shared state to coordinate their behavior. Create an ","type":"text"},{"type":"codeVoice","code":"AppModel"},{"text":" that uses the ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" macro to represent the state of the immersive space.","type":"text"}],"type":"paragraph"}],"chapter":"2. Model the app state"},{"kind":"tasks","tasks":[{"title":"Create an observable state model","contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"A visionOS app often needs to share state across scenes such as ","type":"text"},{"code":"WindowGroup","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ImmersiveSpace","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" macro lets SwiftUI track changes to properties that a view reads and update the view accordingly.","type":"text"}]}],"kind":"contentAndMedia"}],"stepsSection":[{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"code":"AppModel","type":"codeVoice"},{"text":" stores state shared by the window and immersive view. ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" lets SwiftUI track the state a view reads, while ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" keeps UI-related state on the main actor. Both views can then respond to the same information.","type":"text"}]}],"code":"AppModel-01.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"An immersive view takes time to open and close. The ","type":"text"},{"code":"opening","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"closing","type":"codeVoice"},{"text":" cases of ","type":"text"},{"code":"ImmersiveSpaceState","type":"codeVoice"},{"text":" represent these transitions so the app can temporarily disable the button. The ","type":"text"},{"code":"closed","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"open","type":"codeVoice"},{"text":" cases indicate when another transition can begin.","type":"text"}]}],"code":"AppModel-02.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"code":"immersiveSpaceState","type":"codeVoice"},{"text":" records the current state of the immersive view. Its initial value, ","type":"text"},{"code":".closed","type":"codeVoice"},{"text":", lets the window offer the action to enter the space. The window button and immersive view’s dismissal handling update this same value to keep the UI in sync with the space.","type":"text"}]}],"code":"AppModel-03.swift"}],"anchor":"Create-an-observable-state-model"}]},{"abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"code":"SkyAssetCache","type":"codeVoice"},{"type":"text","text":" that prepares these assets when the main window appears."}],"featuredEyebrow":"Tutorial","kind":"callToAction","action":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","isActive":true},"title":"Preload and cache assets"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/2026techmap_tutorial\/chapter1-appmodel"]}],"identifier":{"url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMa