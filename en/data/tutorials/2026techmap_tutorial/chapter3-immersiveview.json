ard let skyTemplate = cache.skyEntityTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","        }","    }","}"],"identifier":"ImmersiveView-01.swift","fileType":"swift","syntax":"swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter5-OvertheCloudApp#Explore-the-completed-app":{"role":"pseudoSymbol","type":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter5-overthecloudapp#Explore-the-completed-app","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp#Explore-the-completed-app","title":"Explore the completed app","abstract":[{"type":"text","text":"Connect "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":", "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ImmersiveView"},{"type":"text","text":" in the app entry point. Register a "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":", and configure the space to use the fully immersive ("},{"type":"codeVoice","code":"full"},{"type":"text","text":") style."}],"kind":"section"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter1-AppModel":{"estimatedTime":"5min","role":"project","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/chapter1-appmodel","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","title":"Model the app state","abstract":[{"type":"text","text":"A window and an immersive view need shared state to coordinate their behavior. Create an "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":" that uses the "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" macro to represent the state of the immersive space."}],"kind":"project"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView":{"estimatedTime":"20min","role":"project","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","title":"Build the immersive content","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}],"kind":"project"},"ImmersiveView-05.swift":{"fileName":"ImmersiveView.swift","type":"file","highlights":[{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"identifier":"ImmersiveView-05.swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"fileType":"swift","syntax":"swift"},"ImmersiveView-02.swift":{"highlights":[{"line":13},{"line":14},{"line":15},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"type":"file","identifier":"ImmersiveView-02.swift","syntax":"swift","fileType":"swift","fileName":"ImmersiveView.swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloud