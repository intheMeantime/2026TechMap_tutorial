{"sections":[{"estimatedTimeInMinutes":20,"chapter":"4. Build the immersive content","content":[{"type":"paragraph","inlineContent":[{"text":"Place the cached sky and clouds in a 3D environment. Use ","type":"text"},{"type":"codeVoice","code":"RealityView"},{"text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion.","type":"text"}]}],"backgroundImage":"ch_thumbnail.png","kind":"hero","image":"ch_thumbnail.png","title":"Build the immersive content"},{"tasks":[{"contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"RealityView","type":"codeVoice"},{"text":" closure adds RealityKit content to the scene. Clone the cached originals and apply position, scale, and rotation to the copies. Keep the originals unchanged so you can reuse them.","type":"text"}]}],"kind":"contentAndMedia"}],"stepsSection":[{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"code":"ImmersiveView","type":"codeVoice"},{"text":" contains the 3D environment the person enters. ","type":"text"},{"code":"RealityView","type":"codeVoice"},{"text":" provides a scene for the sky and clouds; at this stage, it has no content.","type":"text"}]}],"code":"ImmersiveView-00.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Clone the cached sky and add it to the scene. ","type":"text"},{"code":"clone(recursive: true)","type":"codeVoice"},{"text":" includes child entities, leaving the cached original unchanged. The ","type":"text"},{"code":"guard","type":"codeVoice"},{"text":" stops setup if the sky isn’t ready, and ","type":"text"},{"code":"AppModel","type":"codeVoice"},{"text":" will later let the view share dismissal state with the window.","type":"text"}]}],"code":"ImmersiveView-01.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"code":"cloudCount","type":"codeVoice"},{"text":" determines how many clouds appear in the space. Keeping the count in one place makes it easy to adjust.","type":"text"}]}],"code":"ImmersiveView-02a.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"The loop places the specified number of clouds. Each iteration randomly selects and clones model A or B to reduce repetition. Check that both originals are available first. The clouds still overlap at this stage because their positions haven’t been set.","type":"text"}]}],"code":"ImmersiveView-02.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Vary the size of each cloud to add variety to the scene. Applying the same scale to x, y, and z preserves the model’s proportions while changing its overall size.","type":"text"}]}],"code":"ImmersiveView-03a.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Rotation around the y-axis makes each cloud face a different direction. Copies of the same model then present different silhouettes. Choose each angle randomly within a full turn.","type":"text"}]}],"code":"ImmersiveView-03b.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Spread the clouds around the person to form a scene. The x and z coordinates determine horizontal placement, and y determines height. Negative y values place clouds below the space’s default origin to suggest clouds beneath the person.","type":"text"}]}],"code":"ImmersiveView-03.swift"}],"anchor":"Place-the-sky-sphere-and-clouds","title":"Place the sky sphere and clouds"},{"contentSection":[{"mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"text":"Subtle motion adds depth to otherwise stationary clouds. A helper function keeps the animation separate from the placement loop.","type":"text"}]}],"kind":"contentAndMedia"}],"stepsSection":[{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"code":"addFloatingAnimation","type":"codeVoice"},{"text":" defines the start and end transforms for a cloud’s motion. Changing only the y coordinate by ","type":"text"},{"code":"deltaY","type":"codeVoice"},{"text":" creates vertical movement while preserving the cloud’s scale, rotation, and horizontal position.","type":"text"}]}],"code":"ImmersiveView-04a.swift"},{"runtimePreview":null,"caption":[],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"code":"FromToByAnimation","type":"codeVoice"},{"text":" defines movement between two transforms. ","type":"text"},{"code":".easeInOut","type":"codeVoice"},{"text":" softens the start and end of the motion, and ","type":"text"},{"code":".autoReverse","type":"codeVoice"},{"text":" returns along the same path. ","type":"text"},{"code":"playAnimation","type":"codeVoice"},{"text":" applies the animation to the cloud.","type":"text"}]}],"code":"ImmersiveView-04.swift"},{"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"code":".onDisappear","type":"codeVoice"},{"text":" sets the shared state to ","type":"text"},{"code":".closed","type":"codeVoice"},{"text":" when the immersive view disappears. If the system dismisses the space, the main window can return to the button state that lets the person enter again.","type":"text"}]}],"type":"step","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Choose a random travel distance and duration for each cloud. Reuse the same animation helper while giving each cloud a different motion.","type":"text"}]}],"code":"ImmersiveView-05.swift"}],"anchor":"Animate-the-clouds","title":"Animate the clouds"}],"kind":"tasks"},{"title":"Build the main window and transitions","featuredEyebrow":"Tutorial","action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView","isActive":true,"overridingTitle":"Get started"},"kind":"callToAction","abstract":[{"text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps.","type":"text"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview"]}],"kind":"project","hierarchy":{"modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Add-the-sky-texture-and-cloud-models-to-Xcode"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-Set-up-the-project-and-assets"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel#Create-an-observable-state-model"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.-Model-the-app-state"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state"},{"ki