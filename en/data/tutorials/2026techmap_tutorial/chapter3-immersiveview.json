Name":"ImmersiveView.swift","syntax":"swift","fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                content.add(cloudEntity)","            }","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"]},"ImmersiveView-00.swift":{"identifier":"ImmersiveView-00.swift","type":"file","highlights":[],"fileName":"ImmersiveView.swift","syntax":"swift","fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    var body: some View {","        RealityView { _ in }","    }","}"]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/4.-Build-the-immersive-content":{"abstract":[],"type":"topic","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/4.-Build-the-immersive-content","url":"\/tutorials\/2026techmap_tutorial\/4.-build-the-immersive-content","title":"4. Build the immersive content","kind":"article","role":"article"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets":{"abstract":[{"type":"text","text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract "},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"type":"text","text":" from "},{"inlineContent":[{"text":"Project files","type":"text"}],"type":"strong"},{"type":"text","text":" below, then connect the texture to the app target and add the package as a dependency."}],"type":"section","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup#Create-a-visionOS-app-and-download-the-assets","title":"Create a visionOS app and download the assets","kind":"section","role":"pseudoSymbol"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Animate-the-clouds":{"abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"code":"RealityView","type":"codeVoi