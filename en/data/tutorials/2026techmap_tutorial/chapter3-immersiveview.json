{"hierarchy":{"paths":[["doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/$volume","doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/4.-Build-the-immersive-content"]],"modules":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-Set-up-the-project-and-assets","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Add-the-sky-texture-and-cloud-models-to-Xcode"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.-Model-the-app-state","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel#Create-an-observable-state-model"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/3.-Preload-and-cache-assets","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Load-assets-concurrently-without-duplicate-requests"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/4.-Build-the-immersive-content","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/5.-Build-the-main-window-and-transitions","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Display-the-asset-loading-state"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Create-the-space-toggle-and-error-messages"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView#Open-and-close-the-immersive-space"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/6.-Configure-the-app-entry-point","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp","sections":[{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp#Register-the-window-and-immersive-space"},{"kind":"task","reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp#Explore-the-completed-app"}]}]}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView"},"kind":"project","variants":[{"paths":["\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Build the immersive content","category":"OvertheCloud","role":"project","categoryPathComponent":"2026TechMap_tutorial"},"sections":[{"estimatedTimeInMinutes":20,"kind":"hero","title":"Build the immersive content","chapter":"4. Build the immersive content","backgroundImage":"ch_thumbnail.png","image":"ch_thumbnail.png","content":[{"type":"paragraph","inlineContent":[{"text":"Place the cached sky and clouds in a 3D environment. Use ","type":"text"},{"type":"codeVoice","code":"RealityView"},{"text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion.","type":"text"}]}]},{"tasks":[{"stepsSection":[{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ImmersiveView"},{"type":"text","text":" contains the 3D environment the person enters. "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" provides a scene for the sky and clouds; at this stage, it has no content."}]}],"type":"step","code":"ImmersiveView-00.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clone the cached sky and add it to the scene. "},{"type":"codeVoice","code":"clone(recursive: true)"},{"type":"text","text":" includes child entities, leaving the cached original unchanged. The "},{"type":"codeVoice","code":"guard"},{"type":"text","text":" stops setup if the sky isn’t ready, and "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":" will later let the view share dismissal state with the window."}]}],"type":"step","code":"ImmersiveView-01.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cloudCount"},{"type":"text","text":" determines how many clouds appear in the space. Keeping the count in one place makes it easy to adjust."}]}],"type":"step","code":"ImmersiveView-02a.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The loop places the specified number of clouds. Each iteration randomly selects and clones model A or B to reduce repetition. Check that both originals are available first. The clouds still overlap at this stage because their positions haven’t been set."}]}],"type":"step","code":"ImmersiveView-02.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vary the size of each cloud to add variety to the scene. Applying the same scale to x, y, and z preserves the model’s proportions while changing its overall size."}]}],"type":"step","code":"ImmersiveView-03a.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rotation around the y-axis makes each cloud face a different direction. Copies of the same model then present different silhouettes. Choose each angle randomly within a full turn."}]}],"type":"step","code":"ImmersiveView-03b.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spread the clouds around the person to form a scene. The x and z coordinates determine horizontal placement, and y determines height. Negative y values place clouds below the space’s default origin to suggest clouds beneath the person."}]}],"type":"step","code":"ImmersiveView-03.swift","runtimePreview":null,"caption":[]}],"anchor":"Place-the-sky-sphere-and-clouds","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" closure adds RealityKit content to the scene. Clone the cached originals and apply position, scale, and rotation to the copies. Keep the originals unchanged so you can reuse them."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Place the sky sphere and clouds"},{"stepsSection":[{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"addFloatingAnimation"},{"type":"text","text":" defines the start and end transforms for a cloud’s motion. Changing only the y coordinate by "},{"type":"codeVoice","code":"deltaY"},{"type":"text","text":" creates vertical movement while preserving the cloud’s scale, rotation, and horizontal position."}]}],"type":"step","code":"ImmersiveView-04a.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FromToByAnimation"},{"type":"text","text":" defines movement between two transforms. "},{"type":"codeVoice","code":".easeInOut"},{"type":"text","text":" softens the start and end of the motion, and "},{"type":"codeVoice","code":".autoReverse"},{"type":"text","text":" returns along the same path. "},{"type":"codeVoice","code":"playAnimation"},{"type":"text","text":" applies the animation to the cloud."}]}],"type":"step","code":"ImmersiveView-04.swift","runtimePreview":null,"caption":[]},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose a random travel distance and duration for each cloud. Reuse the same animation helper while giving each cloud a different motion."}]}],"type":"step","code":"ImmersiveView-05.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".onDisappear"},{"type":"text","text":" sets the shared state to "},{"type":"codeVoice","code":".closed"},{"type":"text","text":" when the immersive view disappears. If the system dismisses the space, the main window can return to the button state that lets the person enter again."}]}]}],"anchor":"Animate-the-clouds","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subtle motion adds depth to otherwise stationary clouds. A helper function keeps the animation separate from the placement loop."}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"title":"Animate the clouds"}],"kind":"tasks"},{"title":"Build the main window and transitions","abstract":[{"text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps.","type":"text"}],"kind":"callToAction","action":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView","overridingTitle":"Get started","isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference"},"featuredEyebrow":"Tutorial"}],"references":{"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","kind":"overview","url":"\/tutorials\/2026techmap_tutorial","title":"Build an Immersive Space Above the Clouds","type":"topic","role":"overview","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":" in visionOS to build an immersive environment that feels like floating among clouds."}]},"ImmersiveView-04a.swift":{"syntax":"swift","identifier":"ImmersiveView-04a.swift","fileName":"ImmersiveView.swift","type":"file","fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                content.add(cloudEntity)","            }","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","    }","}"],"highlights":[{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter2-SkyAssetCache#Define-the-cached-assets-and-loading-state","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter2-skyassetcache#Define-the-cached-assets-and-loading-state","title":"Define the cached assets and loading state","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Loading the sky and cloud models each time the immersive view opens can interrupt the transition. Create a "},{"type":"codeVoice","code":"SkyAssetCache"},{"type":"text","text":" that prepares these assets when the main window appears."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Animate-the-clouds":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Animate-the-clouds","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Animate-the-clouds","title":"Animate the clouds","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView#Place-the-sky-sphere-and-clouds","kind":"section","url":"\/tutorials\/2026techmap_tutorial\/chapter3-immersiveview#Place-the-sky-sphere-and-clouds","title":"Place the sky sphere and clouds","type":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}]},"ch_thumbnail.png":{"identifier":"ch_thumbnail.png","variants":[{"traits":["1x","light"],"url":"\/images\/2026TechMap_tutorial\/ch_thumbnail.png"}],"type":"image","alt":"A blue sky and clouds behind the chapter heading"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/2.-Model-the-app-state":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.-Model-the-app-state","kind":"article","title":"2. Model the app state","url":"\/tutorials\/2026techmap_tutorial\/2.-model-the-app-state","type":"topic","role":"article","abstract":[]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/5.-Build-the-main-window-and-transitions":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/5.-Build-the-main-window-and-transitions","kind":"article","title":"5. Build the main window and transitions","url":"\/tutorials\/2026techmap_tutorial\/5.-build-the-main-window-and-transitions","type":"topic","role":"article","abstract":[]},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup":{"identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","kind":"project","estimatedTime":"15min","title":"Set up the project and assets","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup","type":"topic","role":"project","abstract":[{"text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract ","type":"text"},{"code":"OvertheCloud-Assets.zip","type":"codeVoice"},{"text":" from ","type":"text"},{"type":"strong","inlineContent":[{"text":"Project files","type":"text"}]},{"text":" below, then connect the texture to the app target and add the package as a dependency.","type":"text"}]},"ImmersiveView-04.swift":{"fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                content.add(cloudEntity)","            }","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"highlights":[{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50},{"line":51},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56}],"fileName":"ImmersiveView.swift","type":"file","syntax":"swift","identifier":"ImmersiveView-04.swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets":{"kind":"section","title":"Create a visionOS app and download the assets","abstract":[{"type":"text","text":"This tutorial uses a sky texture in the app bundle and cloud models in a local Swift package. Download and extract "},{"type":"codeVoice","code":"OvertheCloud-Assets.zip"},{"type":"text","text":" from "},{"type":"strong","inlineContent":[{"text":"Project files","type":"text"}]},{"type":"text","text":" below, then connect the texture to the app target and add the package as a dependency."}],"type":"section","role":"pseudoSymbol","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets","url":"\/tutorials\/2026techmap_tutorial\/chapter0-setup#Create-a-visionOS-app-and-download-the-assets"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/3.-Preload-and-cache-assets":{"kind":"article","title":"3. Preload and cache assets","abstract":[],"type":"topic","role":"article","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/3.-Preload-and-cache-assets","url":"\/tutorials\/2026techmap_tutorial\/3.-preload-and-cache-assets"},"ImmersiveView-05.swift":{"fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"highlights":[{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"fileName":"ImmersiveView.swift","type":"file","syntax":"swift","identifier":"ImmersiveView-05.swift"},"ImmersiveView-03a.swift":{"fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 