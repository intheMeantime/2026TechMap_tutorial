pter5-OvertheCloudApp"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/6.-Configure-the-app-entry-point"}],"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","paths":[["doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/$volume","doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/4.-Build-the-immersive-content"]]},"metadata":{"categoryPathComponent":"2026TechMap_tutorial","title":"Build the immersive content","role":"project","category":"OvertheCloud"},"references":{"ImmersiveView-04.swift":{"fileName":"ImmersiveView.swift","type":"file","highlights":[{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50},{"line":51},{"line":52},{"line":53},{"line":54},{"line":55},{"line":56}],"content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                content.add(cloudEntity)","            }","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"],"identifier":"ImmersiveView-04.swift","fileType":"swift","syntax":"swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter5-OvertheCloudApp":{"estimatedTime":"5min","role":"project","type":"topic","url":"\/tutorials\/2026techmap_tutorial\/chapter5-overthecloudapp","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter5-OvertheCloudApp","title":"Configure the app entry point","abstract":[{"type":"text","text":"Connect "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":", "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ImmersiveView"},{"type":"text","text":" in the app entry point. Register a "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":", and configure the space to use the fully immersive ("},{"type":"codeVoice","code":"full"},{"type":"text","text":") style."}],"kind":"project"},"ImmersiveView-04a.swift":{"fileName":"ImmersiveView.swift","type":"file","highlights":[{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44}],"content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                content.add(cloudEntity)","            }","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","    }","}"],"identifier":"ImmersiveView-04a.swift","fileType":"swift","syntax":"swift"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/6.-Configure-the-app-entry-point":{"role":"article","type":"topic","url":"\/tutorials\/2026techm