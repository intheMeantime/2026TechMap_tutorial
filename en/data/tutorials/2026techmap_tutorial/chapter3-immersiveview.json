l the app state","kind":"article","role":"article"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial":{"abstract":[{"type":"text","text":"Use "},{"code":"RealityView","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ImmersiveSpace","type":"codeVoice"},{"type":"text","text":" in visionOS to build an immersive environment that feels like floating among clouds."}],"type":"topic","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","url":"\/tutorials\/2026techmap_tutorial","title":"Build an Immersive Space Above the Clouds","kind":"overview","role":"overview"},"doc://2026TechMap_tutorial/tutorials/2026TechMap_tutorial/Chapter4-ContentView":{"abstract":[{"type":"text","text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps."}],"type":"topic","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView","url":"\/tutorials\/2026techmap_tutorial\/chapter4-contentview","title":"Build the main window and transitions","kind":"project","role":"project","estimatedTime":"20min"},"ImmersiveView-05.swift":{"identifier":"ImmersiveView-05.swift","type":"file","highlights":[{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"fileName":"ImmersiveView.swift","syntax":"swift","fileType":"swift","content":["import SwiftUI","import RealityKit","","struct ImmersiveView: View {","    @Environment(AppModel.self) private var appModel","","    private let cloudCount = 8","","    var body: some View {","        RealityView { content in","            let cache = SkyAssetCache.shared","","            guard let skyTemplate = cache.skyEntityTemplate,","                  let cloudA = cache.cloudATemplate,","                  let cloudB = cache.cloudBTemplate else { return }","","            content.add(skyTemplate.clone(recursive: true))","","            for _ in 0..<cloudCount {","                let cloudEntity = Bool.random() ? cloudA.clone(recursive: true) : cloudB.clone(recursive: true)","","                let randomScale = Float.random(in: 10.0...20.0)","                cloudEntity.scale = SIMD3<Float>(repeating: randomScale)","","                let randomAngle = Float.random(in: 0...(2 * .pi))","                cloudEntity.orientation = simd_quatf(angle: randomAngle, axis: SIMD3<Float>(0, 1, 0))","","                let randomPosition = SIMD3<Float>(","                    Float.random(in: -20.0...20.0),","                    Float.random(in: -2.0...(-1.5)),","                    Float.random(in: -20.0...20.0)","                )","                cloudEntity.position = randomPosition","","                let randomDuration = Double.random(in: 2.5...6.0)","                let randomDeltaY = Float.random(in: 0.1...0.2)","","                addFloatingAnimation(to: cloudEntity, deltaY: randomDeltaY, duration: randomDuration)","","                content.add(cloudEntity)","            }","","            print(\"\\(cloudCount)개의 자연스러운 구름 배치 완료!\")","        }","        .onDisappear {","            appModel.immersiveSpaceState = .closed","        }","    }","","    private func addFloatingAnimation(to entity: Entity, deltaY: Float, duration: Double) {","        let startTransform = entity.transform","        var endTransform = entity.transform","        endTransform.translation.y += deltaY","","        let floatAnimation = FromToByAnimation<Transform>(","            from: startTransform,","            to: endTransform,","            duration: duration,","            timing: .easeInOut,","            bindTarget: .transform,","            repeatMode: .autoReverse","        )","","        if let animationResource = try? AnimationResource.generate(with: floatAnimation) {","            entity.playAnimation(animationResource)","        }","    }","}"]},"d