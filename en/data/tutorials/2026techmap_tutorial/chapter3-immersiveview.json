{"identifier":{"url":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter3-ImmersiveView","interfaceLanguage":"swift"},"sections":[{"image":"ch_thumbnail.png","kind":"hero","backgroundImage":"ch_thumbnail.png","estimatedTimeInMinutes":20,"title":"Build the immersive content","chapter":"4. Build the immersive content","content":[{"inlineContent":[{"type":"text","text":"Place the cached sky and clouds in a 3D environment. Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" to surround the person with a sky and give the clouds varied shapes, positions, and motion."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"contentSection":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"RealityView"},{"text":" closure adds RealityKit content to the scene. Clone the cached originals and apply position, scale, and rotation to the copies. Keep the originals unchanged so you can reuse them.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"ImmersiveView"},{"text":" contains the 3D environment the person enters. ","type":"text"},{"type":"codeVoice","code":"RealityView"},{"text":" provides a scene for the sky and clouds; at this stage, it has no content.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-00.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Clone the cached sky and add it to the scene. ","type":"text"},{"type":"codeVoice","code":"clone(recursive: true)"},{"text":" includes child entities, leaving the cached original unchanged. The ","type":"text"},{"type":"codeVoice","code":"guard"},{"text":" stops setup if the sky isn’t ready, and ","type":"text"},{"type":"codeVoice","code":"AppModel"},{"text":" will later let the view share dismissal state with the window.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-01.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"cloudCount"},{"text":" determines how many clouds appear in the space. Keeping the count in one place makes it easy to adjust.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-02a.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"The loop places the specified number of clouds. Each iteration randomly selects and clones model A or B to reduce repetition. Check that both originals are available first. The clouds still overlap at this stage because their positions haven’t been set.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-02.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Vary the size of each cloud to add variety to the scene. Applying the same scale to x, y, and z preserves the model’s proportions while changing its overall size.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-03a.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Rotation around the y-axis makes each cloud face a different direction. Copies of the same model then present different silhouettes. Choose each angle randomly within a full turn.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-03b.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Spread the clouds around the person to form a scene. The x and z coordinates determine horizontal placement, and y determines height. Negative y values place clouds below the space’s default origin to suggest clouds beneath the person.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-03.swift","caption":[],"runtimePreview":null}],"anchor":"Place-the-sky-sphere-and-clouds","title":"Place the sky sphere and clouds"},{"contentSection":[{"content":[{"inlineContent":[{"text":"Subtle motion adds depth to otherwise stationary clouds. A helper function keeps the animation separate from the placement loop.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"addFloatingAnimation"},{"text":" defines the start and end transforms for a cloud’s motion. Changing only the y coordinate by ","type":"text"},{"type":"codeVoice","code":"deltaY"},{"text":" creates vertical movement while preserving the cloud’s scale, rotation, and horizontal position.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-04a.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"FromToByAnimation"},{"text":" defines movement between two transforms. ","type":"text"},{"type":"codeVoice","code":".easeInOut"},{"text":" softens the start and end of the motion, and ","type":"text"},{"type":"codeVoice","code":".autoReverse"},{"text":" returns along the same path. ","type":"text"},{"type":"codeVoice","code":"playAnimation"},{"text":" applies the animation to the cloud.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-04.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Choose a random travel distance and duration for each cloud. Reuse the same animation helper while giving each cloud a different motion.","type":"text"}],"type":"paragraph"}],"code":"ImmersiveView-05.swift","caption":[{"inlineContent":[{"type":"codeVoice","code":".onDisappear"},{"text":" sets the shared state to ","type":"text"},{"type":"codeVoice","code":".closed"},{"text":" when the immersive view disappears. If the system dismisses the space, the main window can return to the button state that lets the person enter again.","type":"text"}],"type":"paragraph"}],"runtimePreview":null}],"anchor":"Animate-the-clouds","title":"Animate the clouds"}]},{"abstract":[{"text":"Build a main window that displays asset readiness and lets people enter and leave the immersive view with one button. Connect loading feedback, retry actions, button states, and space transitions in small steps.","type":"text"}],"featuredEyebrow":"Tutorial","kind":"callToAction","title":"Build the main window and transitions","action":{"isActive":true,"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter4-ContentView","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]}}],"kind":"project","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"categoryPathComponent":"2026TechMap_tutorial","role":"project","title":"Build the immersive content","category":"OvertheCloud"},"hierarchy":{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial","modules":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/1.-Set-up-the-project-and-assets","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","sections":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Create-a-visionOS-app-and-download-the-assets","kind":"task"},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup#Add-the-sky-texture-and-cloud-models-to-Xcode","kind":"task"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/2.-Model-the-app-state","projects":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel","sections":[{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter1-AppModel#Create-an-observable-state-model","kind":"task"}]}]},{"reference":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/3.-Preload-and-cache-