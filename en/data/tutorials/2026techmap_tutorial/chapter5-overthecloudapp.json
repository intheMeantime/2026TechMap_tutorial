{"sections":[{"chapter":"6. Configure the app entry point","image":"ch_thumbnail.png","content":[{"inlineContent":[{"type":"text","text":"Connect "},{"type":"codeVoice","code":"AppModel"},{"type":"text","text":", "},{"type":"codeVoice","code":"ContentView"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ImmersiveView"},{"type":"text","text":" in the app entry point. Register a "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":", and configure the space to use the fully immersive ("},{"type":"codeVoice","code":"full"},{"type":"text","text":") style."}],"type":"paragraph"}],"backgroundImage":"ch_thumbnail.png","estimatedTimeInMinutes":5,"title":"Configure the app entry point","kind":"hero"},{"tasks":[{"contentSection":[{"content":[{"inlineContent":[{"text":"A visionOS app declares one or more scenes in the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" of its ","type":"text"},{"type":"codeVoice","code":"App"},{"text":" type. Register both a window (","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":") and an immersive space (","type":"text"},{"type":"codeVoice","code":"ImmersiveSpace"},{"text":") so the button in ","type":"text"},{"type":"codeVoice","code":"ContentView"},{"text":" can open ","type":"text"},{"type":"codeVoice","code":"ImmersiveView"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"OvertheCloudApp"},{"text":" is the entry point that determines the app’s initial interface. ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" provides the main window, and its ","type":"text"},{"type":"codeVoice","code":"ContentView"},{"text":" displays loading feedback and the space toggle.","type":"text"}],"type":"paragraph"}],"code":"OvertheCloudApp-01.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"text":"Pass the app’s ","type":"text"},{"type":"codeVoice","code":"appModel"},{"text":" into the main window so the view can read and update shared state. ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" preserves the instance used by the app, and ","type":"text"},{"type":"codeVoice","code":".environment(appModel)"},{"text":" makes it available to the view. The immersive space in the next step uses this same model.","type":"text"}],"type":"paragraph"}],"code":"OvertheCloudApp-02.swift","caption":[],"runtimePreview":null},{"media":null,"type":"step","content":[{"inlineContent":[{"type":"codeVoice","code":"ImmersiveSpace"},{"text":" registers the 3D space that the button can open. ","type":"text"},{"type":"codeVoice","code":"SkySpace"},{"text":" connects the opening request to this scene, and its ","type":"text"},{"type":"codeVoice","code":"ImmersiveView"},{"text":" displays the sky and clouds.","type":"text"}],"type":"paragraph"}],"code":"OvertheCloudApp-03.swift","caption":[{"inlineContent":[{"text":"Provide the same ","type":"text"},{"type":"codeVoice","code":"appModel"},{"text":" to share state across both views. The ","type":"text"},{"type":"codeVoice","code":".full"},{"text":" style hides the real-world background, surrounding the person with sky and clouds. Run the app to check asset loading and opening and closing the space.","type":"text"}],"type":"paragraph"}],"runtimePreview":null}],"anchor":"Register-the-window-and-immersive-space","title":"Register the window and immersive space"},{"contentSection":[{"content":[{"inlineContent":[{"text":"All the components are now connected. Watch the completed app and compare its behavior with your own project.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":"finalVideo.mp4","type":"step","content":[{"inlineContent":[{"text":"Watch the completed app