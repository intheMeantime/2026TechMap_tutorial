{"sections":[{"backgroundImage":"overthecloud_thumbnail.png","image":"overthecloud_thumbnail.png","kind":"hero","action":{"isActive":true,"type":"reference","overridingTitle":"Get started","identifier":"doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":" in visionOS to build an immersive environment that feels like floating among clouds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Follow the project from start to finish: model shared state, add and preload assets, arrange and animate 3D content, and connect the window controls to immersive transitions."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"–"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before you begin, download the assets in "},{"type":"strong","inlineContent":[{"text":"Chapter 1","type":"text"}]},{"type":"text","text":" and add them to your Xcode project."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can test the app in Simulator without Apple Vision Pro. To fully experience the depth and immersion of the space, run the app on a device."}],"type":"paragraph"}],"title":"Build an Immersive Space Above the Clouds"},{"name":null,"image":null,"kind":"volume","content":[],"chapters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a visionOS app and connect the supplied sky texture and Reality Composer Pro cloud package to the app target. Complete this setup before writing the code in the remaining chapters.","type":"text"}]}],"name":"1. Set up the project and assets","tutorials":["doc:\/\/2026TechMap_tutorial\/tutorials\/2026TechMap_tutorial\/Chapter0-Setup"],"image":"ch1_preview.png"},{"content":[{"type":"paragraph","inlin